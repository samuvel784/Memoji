    <!-- Welcome sheet -->
    <string name="welcome_title">👋 Welcome to Emogy</string>
    <string name="welcome_intro">A calm memory game with 1,000 levels. Every level is open from the start.</string>
    <string name="welcome_pair_title">Find every pair</string>
    <string name="welcome_pair_body">Flip two cards at a time. Matching emoji stay face-up; mismatches flip back after a moment.</string>
    <string name="welcome_best_title">Beat your own best</string>
    <string name="welcome_best_body">Fewer moves and a faster time earn more stars. Replays only improve your records.</string>
    <string name="welcome_more_title">Come back for more</string>
    <string name="welcome_more_body">A new Daily Challenge every day, plus an Emoji Album that fills in as you match pairs.</string>
    <string name="welcome_start">Start Playing</string>
    <string name="welcome_rules">Read the full rules</string>
    <string name="cd_close_welcome">Close welcome</string>

    <!-- How to play -->
    <string name="how_to_play_title">📖 How to Play</string>
    <string name="howto_flip_title">Flip &amp; Match Pairs</string>
    <string name="howto_flip_body">Tap two cards to reveal them. Identical emojis remain face-up. Remember where mismatched emojis are!</string>
    <string name="howto_hints_title">Use Power-up Hints</string>
    <string name="howto_hints_body">Need help? Tap the lightbulb to briefly peek at all hidden cards. Has a 10s cooldown timer.</string>
    <string name="howto_assist_title">Assist Mode</string>
    <string name="howto_assist_body">Turn it on in Settings, then tap the heart in a level to reveal one matching pair. It works on every level and spends no hints, moves or stars.</string>
    <string name="howto_streaks_title">Daily Streaks</string>
    <string name="howto_streaks_body">Play every day to build your streak! Track your progress in Statistics.</string>
    <string name="howto_daily_title">Daily Challenge</string>
    <string name="howto_daily_body">A new 8-pair board every local day. Finish it once to earn 25 coins; replays only improve your daily best time and moves.</string>
    <string name="howto_album_title">Emoji Album</string>
    <string name="howto_album_body">Every pair you match unlocks its emoji in the offline album. Track your collection by category with no purchases or online account.</string>
    <string name="howto_themes_title">Card-Back Themes</string>
    <string name="howto_themes_body">Complete levels or spend coins to unlock card backs. Preview them live in the Themes menu.</string>
    <string name="howto_zen_title">Zen Mode</string>
    <string name="howto_zen_body">Prefer a relaxed game? Turn on Zen Mode in Settings to remove all time and move limits.</string>
    <string name="howto_worlds_title">Themed Worlds</string>
    <string name="howto_worlds_body">Each of the 20 worlds uses its own emoji theme - animals, food, nature, and more!</string>
    <string name="howto_stars_title">Earn 3 Stars</string>
    <string name="howto_stars_body">Solve puzzles with fewer moves and faster times to score up to 3 stars and track personal bests.</string>
    <string name="howto_map_title">1000-Level World Map</string>
    <string name="howto_map_body">Advance sequentially through Easy, Medium, Hard, and Expert tiers across 20 themed worlds.</string>
    <string name="howto_got_it">Got It! Let\'s Play</string>

